rules_version = '2';

// Beavo Firestore rules. COPPA/LGPD-critical: every document lives under
// users/{uid} and only that signed-in parent can read or write it. Children
// never authenticate. Every write is type-checked; anything not matched below
// (including the legacy top-level /children and /sessions) is denied.
// Tests: npm run test:emulator (Firestore emulator).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function data() {
      return request.resource.data;
    }

    // Every write under users/{uid} (except archiving and deleting) needs the
    // parent's consent record (users/{uid}.consent, written by app/consent.tsx).
    // Account erasure deletes the profile first, so from then on no device can
    // add records while the rest is being deleted. getAfter: the consent write
    // may be in the same batch or queued just before (offline).
    // A CURRENT receipt: today's versions and the health-data item, the same
    // test a new consent write must pass. An older receipt (e.g. from a release
    // before the health-data item) authorizes nothing until the parent re-consents.
    function hasConsented(uid) {
      let user = /databases/$(database)/documents/users/$(uid);
      return notErasing(uid) && existsAfter(user) && isCurrentReceipt(getAfter(user).data.get('consent', null));
    }

    function isCurrentReceipt(c) {
      return c is map
        && c.get('termsVersion', '') == currentTermsVersion()
        && c.get('privacyVersion', '') == currentPrivacyVersion()
        && c.get('healthData', false) == true;
    }

    // Account erasure writes erasures/{uid} first (src/data/account.ts). From then
    // on nothing under users/{uid} can be created or changed — not even the
    // profile — by any device still holding a valid token; only archiving and
    // deleting work. The marker can't be removed by the client.
    function notErasing(uid) {
      return !exists(/databases/$(database)/documents/erasures/$(uid));
    }

    // Child subcollection writes need the child to exist and not be mid-deletion
    // (deleteChild archives first). Stops a late or offline-queued write from
    // recreating data under a deleted child, where delete/export can't find it.
    function childIsLive(uid, childId) {
      let child = /databases/$(database)/documents/users/$(uid)/children/$(childId);
      return existsAfter(child) && getAfter(child).data.archivedAt == null;
    }

    function shape(required, optional) {
      return data().keys().hasAll(required) && data().keys().hasOnly(required.concat(optional));
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    function nonEmpty(v, max) {
      return str(v, max) && v.size() > 0;
    }

    function nullableTimestamp(v) {
      return v == null || v is timestamp;
    }

    function hhmm(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function ymd(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function hexColor(v) {
      return v is string && v.matches('^#[0-9A-Fa-f]{6}$');
    }

    // FDI tooth numbers: permanent 11–48 (quadrants 1–4, teeth 1–8),
    // primary 51–85 (quadrants 5–8, teeth 1–5).
    function fdi(v) {
      return v is int
        && ((v >= 11 && v <= 48 && v % 10 >= 1 && v % 10 <= 8)
          || (v >= 51 && v <= 85 && v % 10 >= 1 && v % 10 <= 5));
    }

    // The document versions parents accept today: LEGAL_VERSIONS in lib/legal.ts.
    // tests/rules.test.ts fails when these drift; bump both together and deploy
    // the rules with the app release that bumps them (docs/RUNBOOK.md).
    function currentTermsVersion() {
      return '2026-11-22';
    }

    function currentPrivacyVersion() {
      return '2026-11-22';
    }

    // A new consent record: today's versions, the separate children's-health-data
    // item, and the server's own clock (the app sends serverTimestamp()), so the
    // client can't backdate it or claim a version it never showed.
    function validNewConsent(c) {
      return c is map
        && c.keys().hasAll(['termsVersion', 'privacyVersion', 'healthData', 'acceptedAt'])
        && c.keys().hasOnly(['termsVersion', 'privacyVersion', 'healthData', 'acceptedAt'])
        && c.termsVersion == currentTermsVersion()
        && c.privacyVersion == currentPrivacyVersion()
        && c.healthData == true
        && c.acceptedAt == request.time;
    }

    // Any other write of the profile keeps the consent record exactly as stored.
    function consentUnchanged() {
      return resource != null && data().get('consent', null) == resource.data.get('consent', null);
    }

    function validUser() {
      return shape(['displayName', 'locale', 'createdAt'], ['consent'])
        && str(data().displayName, 100)
        && data().locale in ['pt-BR', 'en', 'es']
        && data().createdAt is timestamp
        && (!('consent' in data()) || consentUnchanged() || validNewConsent(data().consent));
    }

    // Archiving is the first step of deleting a child; it must still work while
    // the account is being erased (profile already gone, see hasConsented).
    function onlyArchiving() {
      return data().diff(resource.data).affectedKeys().hasOnly(['archivedAt'])
        && data().archivedAt is timestamp;
    }

    function validChild() {
      return shape(['name', 'avatarColor', 'avatarIcon', 'kidMode', 'createdAt', 'archivedAt'], ['birthYear'])
        && nonEmpty(data().name, 40)
        && hexColor(data().avatarColor)
        && nonEmpty(data().avatarIcon, 30)
        && (!('birthYear' in data()) || data().birthYear == null
          || (data().birthYear is int && data().birthYear >= 1990 && data().birthYear <= 2100))
        && data().kidMode is bool
        && data().createdAt is timestamp
        && nullableTimestamp(data().archivedAt);
    }

    function validSlot() {
      return shape(['label', 'icon', 'mealType', 'windowStart', 'windowEnd', 'sortOrder', 'createdAt', 'archivedAt'], [])
        && nonEmpty(data().label, 40)
        && nonEmpty(data().icon, 30)
        && data().mealType in ['breakfast', 'lunch', 'dinner', 'custom']
        && hhmm(data().windowStart)
        && hhmm(data().windowEnd)
        && data().windowStart < data().windowEnd
        && data().sortOrder is int && data().sortOrder >= 0
        && data().createdAt is timestamp
        && nullableTimestamp(data().archivedAt);
    }

    function validSession() {
      return shape(['slotId', 'date', 'startedAt', 'durationSec', 'completed'], [])
        && nonEmpty(data().slotId, 128)
        && ymd(data().date)
        && data().startedAt is timestamp
        && data().durationSec is int && data().durationSec >= 0 && data().durationSec <= 3600
        && data().completed is bool;
    }

    function validToothEvent() {
      return shape(['fdi', 'type', 'categoryId', 'note', 'date'], [])
        && fdi(data().fdi)
        && data().type in ['symptom', 'treatment']
        && nonEmpty(data().categoryId, 128)
        && str(data().note, 500)
        && ymd(data().date);
    }

    function validCategory() {
      return shape(['name', 'type', 'color', 'isDefault'], [])
        && nonEmpty(data().name, 40)
        && data().type in ['symptom', 'treatment']
        && hexColor(data().color)
        && data().isDefault is bool;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validUser() && notErasing(uid);
      // createdAt is the account date: set once, never moved.
      allow update: if isOwner(uid) && validUser() && data().createdAt == resource.data.createdAt && notErasing(uid);

      match /children/{childId} {
        allow read: if isOwner(uid);
        // Only an archived child can be deleted (deleteChild archives, empties the
        // subcollections, then deletes), so a live child's records can't be
        // orphaned under a missing parent document.
        allow delete: if isOwner(uid) && resource.data.get('archivedAt', null) != null;
        // createdAt is set once and never moved (slot/day history depends on it).
        allow create: if isOwner(uid) && validChild() && hasConsented(uid);
        allow update: if isOwner(uid) && validChild() && data().createdAt == resource.data.createdAt
          && (hasConsented(uid) || onlyArchiving());

        match /brushingSlots/{slotId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && validSlot() && childIsLive(uid, childId) && hasConsented(uid);
          allow update: if isOwner(uid) && validSlot() && data().createdAt == resource.data.createdAt && childIsLive(uid, childId) && hasConsented(uid);
        }

        match /brushingSessions/{sessionId} {
          allow read, delete: if isOwner(uid);
          // Create and update: a retried save overwrites the same id.
          allow create, update: if isOwner(uid) && validSession() && childIsLive(uid, childId) && hasConsented(uid);
        }

        match /toothEvents/{eventId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validToothEvent() && childIsLive(uid, childId) && hasConsented(uid);
        }
      }

      match /categories/{categoryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCategory() && hasConsented(uid);
      }
    }

    // Erasure marker: written once when account deletion starts (rewritten on a
    // retry), never deleted by the client. Holds only the start time.
    // ponytail: a trusted worker (Cloud Function) should finish an abandoned
    // erasure and delete the marker with the Auth user; see ADR 0007.
    match /erasures/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && data().keys().hasAll(['startedAt']) && data().keys().hasOnly(['startedAt'])
        && data().startedAt == request.time;
    }
  }
}
