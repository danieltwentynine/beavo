{
  "expo": {
    "name": "Beavo",
    "slug": "beavo",
    "version": "1.0.0",
    "scheme": "beavo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beavo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Beavo uses the front camera only as a mirror so your child can see themselves while brushing. Nothing is recorded, saved or sent."
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A746E",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.beavo.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withGoogleSignInScheme",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7EA"
        }
      ],
      "./plugins/withSceneLifecycle",
      "expo-localization",
      "expo-sharing",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Beavo uses Face ID only to confirm a grown-up before the parental PIN is created or changed."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e404b74-176b-4f4b-8b9a-54804689fc76"
      }
    },
    "owner": "dnlcrds",
    "locales": {
      "en": "./locales/en.json",
      "pt-BR": "./locales/pt-BR.json",
      "es": "./locales/es.json"
    }
  }
}
