{
  "expo": {
    "name": "Beavo",
    "slug": "beavo",
    "version": "1.0.0",
    "scheme": "beavo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dcrds.beavo",
      "infoPlist": {
        "NSCameraUsageDescription": "O Beavo usa a câmera frontal apenas como espelho, para a criança se ver enquanto escova. Nada é gravado, salvo ou enviado.",
        "CFBundleDevelopmentRegion": "pt-BR"
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A746E",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dcrds.beavo"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withGoogleSignInScheme",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7EA"
        }
      ],
      "./plugins/withSceneLifecycle",
      "expo-localization",
      "expo-sharing",
      "./plugins/withoutPushEntitlement",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false,
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0A746E"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "O Beavo usa o Face ID apenas para confirmar que é um adulto antes de criar ou trocar o PIN dos pais."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e404b74-176b-4f4b-8b9a-54804689fc76"
      }
    },
    "owner": "dnlcrds",
    "locales": {
      "pt-BR": "./locales/pt-BR.json"
    }
  }
}
